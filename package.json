{
  "name": "groundtruth-guard",
  "version": "0.1.0",
  "description": "Verifies AI-generated code against real sources before trusting it.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:file": "node scripts/verify-file.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "express": "^4.19.2",
    "tar-stream": "^3.1.7",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.29",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/tar-stream": "^3.1.3",
    "stripe": "^16.12.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
