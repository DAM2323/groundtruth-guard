# Server port
PORT=3000

# Path to the SQLite database file (node:sqlite, requires Node >= 22.5)
PATTERN_DB_PATH=./data/patterns.sqlite

# Docker image used by the sandbox-execution agent
SANDBOX_IMAGE=groundtruth-sandbox:latest

# Maximum time (ms) the sandbox container is allowed to run
SANDBOX_TIMEOUT_MS=5000

# Comma-separated list of npm packages to pre-warm inside the sandbox image
PREWARM_PACKAGES=stripe
